<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CAD & 3D Modeling Portfolio</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js & OrbitControls -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <!-- STLLoader (3D STL 파일 불러오기용) -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">

  <!-- Header -->
  <header class="border-b border-slate-800 p-6 flex justify-between items-center max-w-6xl mx-auto">
    <div>
      <h1 class="text-xl font-bold text-indigo-400">DESIGN PORTFOLIO</h1>
      <p class="text-xs text-slate-400 mt-0.5">3D Modeling & CAD Archive</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button id="adminAuthBtn" onclick="toggleAuthModal()" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 transition flex items-center gap-1.5">
        <span id="loginBtnText">관리자 로그인</span>
      </button>

      <button id="addProjectBtn" onclick="openProjectModal()" class="hidden bg-indigo-600 hover:bg-indigo-500 px-4 py-1.5 rounded-lg text-xs font-medium text-white transition">
        + 프로젝트 등록
      </button>
    </div>
  </header>

  <main class="max-w-6xl mx-auto p-6">
    <div id="guestBanner" class="mb-6 p-4 bg-slate-800/50 border border-slate-700/50 rounded-lg text-sm text-slate-400 flex items-center justify-between">
      <span>💡 자유롭게 3D 모델을 회전하고 도면/모델링 파일을 다운로드할 수 있습니다.</span>
      <span class="text-xs bg-slate-800 px-2.5 py-1 rounded border border-slate-700 text-slate-400">게스트 모드</span>
    </div>

    <!-- Dynamic Projects Grid -->
    <div id="projectsGrid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="col-span-full text-center py-12 text-slate-500">프로젝트를 불러오는 중입니다...</div>
    </div>
  </main>

  <!-- Login Modal -->
  <div id="loginModal" class="fixed inset-0 bg-black/80 flex items-center justify-center hidden p-4 z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 w-full max-w-sm">
      <h3 class="text-lg font-bold mb-1 text-white">관리자 로그인</h3>
      <p class="text-xs text-slate-400 mb-4">Supabase 계정 정보를 입력하세요.</p>
      
      <form onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">이메일</label>
          <input type="email" id="loginEmail" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">비밀번호</label>
          <input type="password" id="loginPassword" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeLoginModal()" class="px-3 py-1.5 bg-slate-700 rounded text-xs text-slate-300">취소</button>
          <button type="submit" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded text-xs font-medium text-white">로그인</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Upload/Edit Modal -->
  <div id="projectModal" class="fixed inset-0 bg-black/80 flex items-center justify-center hidden p-4 z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 w-full max-w-md">
      <h3 class="text-lg font-bold mb-4 text-white">새 프로젝트 등록</h3>
      <form onsubmit="handleProjectUpload(event)" class="space-y-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">작품명</label>
          <input type="text" id="projectTitle" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-xs text-white focus:outline-none">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">설명</label>
          <textarea id="projectDesc" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-xs text-white h-20 focus:outline-none"></textarea>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">3D 모델링 파일 (.stl)</label>
          <input type="file" id="modelFile" accept=".stl" class="w-full text-xs text-slate-400 file:mr-4 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:bg-indigo-600 file:text-white cursor-pointer">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">다운로드용 도면/CAD 파일 (.step, .pdf)</label>
          <input type="file" id="cadFile" class="w-full text-xs text-slate-400 file:mr-4 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:bg-slate-700 file:text-white cursor-pointer">
        </div>
        <div class="flex justify-end gap-2 pt-3">
          <button type="button" onclick="closeProjectModal()" class="px-3 py-1.5 bg-slate-700 rounded text-xs text-slate-300">취소</button>
          <button type="submit" id="submitBtn" class="px-4 py-1.5 bg-indigo-600 rounded text-xs font-medium text-white">저장 및 업로드</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // 1. Supabase 클라이언트 초기화 (본인의 프로젝트 값으로 변경하세요)
    const SUPABASE_URL = "https://YOUR_SUPABASE_URL.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let currentUser = null;

    // 페이지 진입 시 로그인 체크 및 프로젝트 목록 로드
    window.onload = async () => {
      const { data: { user } } = await supabaseClient.auth.getUser();
      updateAuthState(user);
      loadProjects();
    };

    function updateAuthState(user) {
      currentUser = user;
      const addBtn = document.getElementById('addProjectBtn');
      const loginBtnText = document.getElementById('loginBtnText');
      const guestBanner = document.getElementById('guestBanner');

      if (user) {
        addBtn.classList.remove('hidden');
        loginBtnText.innerText = '로그아웃';
        guestBanner.classList.add('hidden');
      } else {
        addBtn.classList.add('hidden');
        loginBtnText.innerText = '관리자 로그인';
        guestBanner.classList.remove('hidden');
      }
    }

    // Auth 인증 처리
    function toggleAuthModal() {
      if (currentUser) {
        if (confirm('로그아웃 하시겠습니까?')) {
          supabaseClient.auth.signOut().then(() => {
            updateAuthState(null);
            loadProjects();
          });
        }
      } else {
        document.getElementById('loginModal').classList.remove('hidden');
      }
    }

    function closeLoginModal() {
      document.getElementById('loginModal').classList.add('hidden');
    }

    async function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;

      const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
      if (error) {
        alert('로그인 실패: ' + error.message);
      } else {
        updateAuthState(data.user);
        closeLoginModal();
        loadProjects();
      }
    }

    // 프로젝트 목록 및 3D 뷰어 로드
    async function loadProjects() {
      const container = document.getElementById('projectsGrid');
      const { data: projects, error } = await supabaseClient.from('projects').select('*').order('created_at', { ascending: false });

      if (error) {
        container.innerHTML = `<div class="col-span-full text-center text-red-400">데이터 불러오기 오류: ${error.message}</div>`;
        return;
      }

      if (!projects || projects.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center text-slate-500 py-12">등록된 프로젝트가 없습니다.</div>`;
        return;
      }

      container.innerHTML = '';
      projects.forEach((item, index) => {
        const cardHtml = `
          <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden shadow-lg flex flex-col">
            <div id="viewer-${item.id}" class="w-full h-52 bg-slate-950 relative"></div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-base font-semibold text-white mb-1">${item.title}</h2>
                <p class="text-slate-400 text-xs leading-relaxed mb-4">${item.description}</p>
              </div>
              <div class="space-y-2 pt-3 border-t border-slate-700/50">
                <div class="flex gap-2">
                  ${item.model_url ? `<a href="${item.model_url}" download class="flex-1 text-center bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 py-1.5 rounded text-xs">3D 다운로드</a>` : ''}
                  ${item.cad_url ? `<a href="${item.cad_url}" download class="flex-1 text-center bg-slate-700 hover:bg-slate-600 text-slate-200 py-1.5 rounded text-xs">도면 다운로드</a>` : ''}
                </div>
                ${currentUser ? `
                  <button onclick="deleteProject('${item.id}', '${item.model_url}', '${item.cad_url}')" class="w-full mt-2 bg-red-950/40 hover:bg-red-900/50 text-red-400 text-xs py-1 rounded border border-red-800/40">
                    🗑️ 삭제
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', cardHtml);

        // STL 파일이 등록되어 있을 경우 3D 렌더링 초기화
        if (item.model_url) {
          initSTLViewer(`viewer-${item.id}`, item.model_url);
        }
      });
    }

    // Three.js STL Renderer
    function initSTLViewer(elementId, modelUrl) {
      const parent = document.getElementById(elementId);
      if (!parent) return;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, parent.clientWidth / parent.clientHeight, 0.1, 1000);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(parent.clientWidth, parent.clientHeight);
      parent.appendChild(renderer.domElement);

      const light = new THREE.DirectionalLight(0xffffff, 1);
      light.position.set(1, 1, 1).normalize();
      scene.add(light);
      scene.add(new THREE.AmbientLight(0x404040));

      const loader = new THREE.STLLoader();
      loader.load(modelUrl, (geometry) => {
        const material = new THREE.MeshPhongMaterial({ color: 0x6366f1, specular: 0x111111, shininess: 200 });
        const mesh = new THREE.Mesh(geometry, material);
        geometry.center();
        scene.add(mesh);

        // 자동 바운딩 줌 조절
        geometry.computeBoundingSphere();
        const radius = geometry.boundingSphere.radius;
        camera.position.z = radius * 2.5;

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableZoom = false;

        function animate() {
          requestAnimationFrame(animate);
          mesh.rotation.y += 0.005;
          controls.update();
          renderer.render(scene, camera);
        }
        animate();
      }, undefined, (err) => {
        parent.innerHTML = `<div class="text-xs text-slate-500 p-4">3D 프리뷰를 불러올 수 없습니다.</div>`;
      });
    }

    // 모달 및 업로드 처리
    function openProjectModal() {
      document.getElementById('projectModal').classList.remove('hidden');
    }

    function closeProjectModal() {
      document.getElementById('projectModal').classList.add('hidden');
    }

    async function handleProjectUpload(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.innerText = '업로드 중...';

      try {
        const title = document.getElementById('projectTitle').value;
        const description = document.getElementById('projectDesc').value;
        const modelFile = document.getElementById('modelFile').files[0];
        const cadFile = document.getElementById('cadFile').files[0];

        let model_url = null;
        let cad_url = null;

        // 1. Storage 파일 업로드 (Model)
        if (modelFile) {
          const path = `models/${Date.now()}_${modelFile.name}`;
          const { error: modelErr } = await supabaseClient.storage.from('portfolio-files').upload(path, modelFile);
          if (modelErr) throw modelErr;
          model_url = supabaseClient.storage.from('portfolio-files').getPublicUrl(path).data.publicUrl;
        }

        // 2. Storage 파일 업로드 (CAD/도면)
        if (cadFile) {
          const path = `cads/${Date.now()}_${cadFile.name}`;
          const { error: cadErr } = await supabaseClient.storage.from('portfolio-files').upload(path, cadFile);
          if (cadErr) throw cadErr;
          cad_url = supabaseClient.storage.from('portfolio-files').getPublicUrl(path).data.publicUrl;
        }

        // 3. Database 기록 저장
        const { error: dbErr } = await supabaseClient.from('projects').insert([{ title, description, model_url, cad_url }]);
        if (dbErr) throw dbErr;

        alert('성공적으로 등록되었습니다!');
        closeProjectModal();
        loadProjects();
      } catch (err) {
        alert('업로드 오류: ' + err.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = '저장 및 업로드';
      }
    }

    // 프로젝트 삭제
    async function deleteProject(id, modelUrl, cadUrl) {
      if (!confirm('이 프로젝트를 삭제하시겠습니까?')) return;

      try {
        // DB 데이터 삭제
        const { error } = await supabaseClient.from('projects').delete().eq('id', id);
        if (error) throw error;

        alert('삭제되었습니다.');
        loadProjects();
      } catch (err) {
        alert('삭제 오류: ' + err.message);
      }
    }
  </script>
</body>
</html>
